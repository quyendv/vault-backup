# Copy to .env and fill in real values: cp .env.example .env
#
# Docker Compose loads this file automatically as env_file for the service.

# --- Vault ---
# Use a URL reachable from inside the container.
VAULT_ADDR=http://host.docker.internal:8200
# Token with backup policy (not root): policies/backup-raft.hcl
#   vault token create -policy=backup-raft -period=24h -orphan
# Or use VAULT_TOKEN_FILE + a volume (see docker-compose.yml).
VAULT_TOKEN=hvs.1234567890
# VAULT_TOKEN_FILE=/etc/vault/backup-token

# --- Local paths inside the container (overridden in docker-compose for BACKUP_DIR/LOG_FILE) ---
# RETENTION_LOCAL_DAYS=3

# --- S3-compatible storage ---
S3_BUCKET=my-backups
S3_PREFIX=vault-snapshots
S3_ENDPOINT=http://minio.internal:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
RETENTION_S3_DAYS=30

# --- Optional: in-container cron (supercronic). Leave empty for one-shot `docker compose run`. ---
# SCHEDULE=0 */4 * * *
# RESTART_POLICY=unless-stopped
